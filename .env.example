# 3D Cadastral Intelligence & Property Identification System
# Root environment configuration template

# Database (PostGIS)
DATABASE_URL=postgresql+psycopg://cadastral:cadastral_dev_only@localhost:5432/cadastral

# Redis Cache / Task Queue
REDIS_URL=redis://localhost:6379/0

# Working Coordinate Reference System (Default: WGS84)
WORKING_CRS=EPSG:4326

# Authentication & Security (Change for production)
SECRET_KEY=CHANGE-ME-IN-PRODUCTION
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Object Storage (MinIO / S3)
OBJECT_STORE_ENDPOINT=
OBJECT_STORE_BUCKET=cadastral-evidence

# Application Logging
LOG_LEVEL=INFO